SNOWFLAKE_ACCOUNT_URL=your-account.snowflakecomputing.com
SNOWFLAKE_DATABASE=FRAUD_DETECTION_DB
SNOWFLAKE_SCHEMA=FRAUD_DETECTION_SCHEMA
SNOWFLAKE_AGENT=FRAUD_DETECTION_AGENT
SNOWFLAKE_MODEL_ID=claude-sonnet-4-6

SNOWFLAKE_PAT_TOKEN=your-snowflake-programmatic-access-token

# AgentCore Web Search is a managed Gateway connector — no API key needed.
# Requires a region where AgentCore Web Search is available (e.g. us-east-1).
AWS_REGION=us-east-1
MODEL_ID=global.anthropic.claude-sonnet-4-6

SNS_TOPIC_ARN=your-sns-topic-arn

# AgentCore Memory (STM+LTM). Create the resource with `agentcore memory create`
# (see README "Memory setup") and paste the memory id here.
AGENTCORE_MEMORY_ID=

# REQUIRED: Amazon Bedrock Guardrails. Deploy infrastructure/bedrock-guardrails.yaml
# and paste its outputs here (see README "Guardrails setup"). The agent fails closed
# if these are unset. To run without guardrails you must opt out explicitly with
# ALLOW_NO_GUARDRAILS=true, which disables all content filtering and PII masking.
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=

# Optional tuning knobs — code defaults shown, see README "Optional tuning variables".
# None of these is in the `agentcore deploy` RUNTIME_KEYS allowlist, so setting them
# here affects local runs only, not the deployed runtime.
# AGENTCORE_MEMORY_REGION falls back to AWS_REGION, then us-east-1.
#AGENTCORE_MEMORY_REGION=
#WEBSEARCH_TIMEOUT_SECONDS=30
#SNOWFLAKE_TIMEOUT_SECONDS=180
#GATEWAY_TIMEOUT_SECONDS=30
#SNOWFLAKE_CACHE_TTL_SECONDS=300
